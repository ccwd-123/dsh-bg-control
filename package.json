{
  "name": "dsh-bg-control",
  "version": "0.2.0",
  "description": "Windows background application control plugin for DeepSeek Harness (DSH 0.2.2-rc.1), with a hard foreground focus guard, hidden/minimized launch, CLI/COM/IPC control, async jobs, and verifiable artifacts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tests",
    "verification",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "scripts": {
    "test": "node tests/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccwd-123/dsh-bg-control.git"
  },
  "homepage": "https://github.com/ccwd-123/dsh-bg-control#readme",
  "bugs": {
    "url": "https://github.com/ccwd-123/dsh-bg-control/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "windows",
    "desktop-automation",
    "plugin"
  ],
  "author": "ccwd-123",
  "license": "MIT"
}
